# Copiar a .env y completar. NUNCA commitear .env.
NODE_ENV=development
PORT=4000

# supabase (producción) | local (PGlite + fotos en server/.data, sin Postgres ni Supabase).
# Si se omite: local cuando SUPABASE_URL falta o es el placeholder; si no, supabase.
DB_MODE=supabase

# Supabase (Settings > API). La SERVICE_ROLE key solo vive en el server.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=reemplazar-por-service-role-key

# Schema Postgres de la app (tablas, vista y funciones de db/schema.sql). Default: appfiesta.
# En Supabase debe figurar en Settings > Data API > Exposed schemas.
# DB_SCHEMA=appfiesta

# >= 32 bytes aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-bytes

# Origen(es) permitidos por CORS (separados por coma). En dev: Vite.
CORS_ORIGIN=http://localhost:5173

# URL pública donde se sirve la app (informativa / logs / links).
PUBLIC_BASE_URL=http://localhost:5173

# Password inicial para `npm run seed:admin` (si falta, se pide por consola).
SEED_ADMIN_PASSWORD=

# Opcional: nivel de log de pino (debug, info, warn, error)
LOG_LEVEL=info
